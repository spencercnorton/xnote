dnl Process this file with autoconf to produce a configure script.
AC_INIT(src/fio.c)
AC_CONFIG_AUX_DIR(autoconf)
AC_CONFIG_HEADER(src/config.h:autoconf/config.h.in)

dnl xpad version
dnl line taken from aterm project
VERSION=`sed -n -e 's/^.*VERSION.*"\(.*\)"$/\1/p' src/defines.h`
AC_SUBST(VERSION)

dnl Checks for programs.
AC_PROG_CC
AC_PROG_INSTALL

dnl Checks for libraries.
dnl Replace `main' with a function in -libs:
dnl I don't know what this is...  AC_CHECK_LIB(ibs, main)

dnl Checks for header files.
AC_HEADER_STDC
AC_CHECK_HEADERS(unistd.h)

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_SIZE_T
AC_HEADER_TIME

dnl Checks for library functions.
AC_TYPE_SIGNAL
AC_CHECK_FUNCS(mkdir select socket strcspn strstr strtol)

AC_OUTPUT(Makefile src/Makefile doc/Makefile images/Makefile, echo timestamp > autoconf/stamp-h)
