SHELL = /bin/sh
top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@

INSTALL = @INSTALL@
INSTALL_PROGRAM = $(INSTALL)
INSTALL_DATA = $(INSTALL) -m 644
prefix = @prefix@
exec_prefix = @exec_prefix@
datadir = @datadir@
bindir = @bindir@
libdir = @libdir@
infodir = @infodir@
mandir = @mandir@
icondir = $(datadir)/pixmaps/xpad

IMAGES = xpad.xpm

all: $(IMAGES)

install: all
	$(top_srcdir)/autoconf/mkinstalldirs $(icondir)
	$(INSTALL_DATA) xpad.xpm $(icondir)

uninstall:
	/bin/rm -f $(icondir)/xpad.xpm

clean:

distclean: clean
	/bin/rm -f *~ .\#* Makefile

mostlyclean: clean

maintainer-clean: clean
