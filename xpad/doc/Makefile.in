SHELL = /bin/sh
top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@

INSTALL = @INSTALL@
INSTALL_PROGRAM = $(INSTALL)
INSTALL_DATA = $(INSTALL) -m 644
prefix = @prefix@
exec_prefix = @exec_prefix@
datadir = @datadir@
bindir = @bindir@
libdir = @libdir@
infodir = @infodir@
mandir = @mandir@
man1dir = $(mandir)/man1

DOCS = xpad.1

all: $(DOCS)

install: all
	$(top_srcdir)/autoconf/mkinstalldirs $(man1dir)
	$(INSTALL_DATA) xpad.1 $(man1dir)

uninstall:
	/bin/rm -f $(man1dir)/xpad.1*

clean:

distclean: clean
	/bin/rm -f *~ .\#* Makefile stamp-h

mostlyclean: clean

maintainer-clean: clean

