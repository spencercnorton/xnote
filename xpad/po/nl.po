#: src/main.c:205
msgid "Illegal \"--verbosity\" value.  Must be either 0, 1, or 2.\n"
msgstr "Onjuiste \"--verbosity\" waarde.  Moet 0, 1 of 2 zijn.\n"

#: src/main.c:267
msgid "Prints usage information and exits"
msgstr "Gebruiksinformatie weergeven en afsluiten"

#: src/main.c:268
msgid "Prints xpad version and exits"
msgstr "Versie van xpad weergeven en afsluiten"

#: src/main.c:269
msgid "Sets the amount of debugging ouput (can be 0, 1, or 2; default is 0)"
msgstr ""
"Hoeveelheid debug-uitvoer instellen (kan 0, 1 of 2 zijn; standaard is 0)"

#: src/main.c:270
msgid ""
"Prevents xpad from creating a new pad on startup if no previous pads exist"
msgstr ""
"Voorkomen dat xpad een nieuw kladblok opent bij het starten, als er nog geen "
"kladblok was"

#. registered here a second time because it has effects both on local instances and remote instances
#: src/main.c:274
msgid "Causes xpad to create a new pad on startup even if pads already exist"
msgstr "Zorgen dat xpad een nieuw kladblok opent, zelfs als er al een bestaat"

#: src/main.c:275
msgid "Causes all running xpad instances to close"
msgstr "Zorgen dat alle lopende xpad vensters sluiten"

#: src/main.c:276
msgid "Lists the titles of all open pads"
msgstr "De namen van alle open kladblokken opsommen"

#: src/main.c:277
msgid ""
"Causes the Nth pad (1-based) to present itself to the user; pad numbers can "
"be seen by using \"--list\""
msgstr ""
"Zorgen dat het N-de kladblok (1-gebaseerd) zichzelf aan de gebruiker toont; "
"kladbloknummers kunnen worden opgesomd met \"--list\""

#: src/main.c:278
msgid "Causes all pads to present themselves to the user"
msgstr "Zorgen dat alle kladblokken zichzelf aan de gebruiker tonen"

#: src/main.c:310
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
msgstr ""
"Gebruik: xpad [OPTIES]\n"
"\n"

#: src/main.c:346
#, c-format
msgid "Missing companion argument to %s\n"
msgstr "Ontbrekend samengaand argument bij %s\n"

#: src/main.c:395
#, c-format
msgid "Didn't understand argument '%s'\n"
msgstr "Argument niet begrepen '%s'\n"

#: src/main.c:451
#, c-format
msgid "Invalid number: '%s'\n"
msgstr "Onjuist nummer: '%s'\n"

#: src/fio.c:84
#, c-format
msgid "Could not write to file %s."
msgstr "Kon niet schrijen naar bestand %s."

#: src/fio.c:110
#, c-format
msgid "Could not read from file %s."
msgstr "Kon niet lezen uit bestand %s."

#: src/fio.c:438
#, c-format
msgid "Could not open directory %s."
msgstr "Kon map %s niet openen."

#: src/fio.c:441
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Deze map is nodig om de voorkeuren- en kladblokinformatie in op te slaan. "
"Xpad sluit nu af."

#: src/pref.c:288 src/properties.c:228
