msgstr "Nombre invalide: « %s »\n"

#: src/fio.c:84
#, c-format
msgid "Could not write to file %s."
msgstr "N'a pu écrire dans le fichier %s."

#: src/fio.c:110
#, c-format
msgid "Could not read from file %s."
msgstr "N'a pu lire à partir du fichier %s."

#: src/fio.c:418
#, c-format
msgid "Could not open directory %s."
msgstr "Ne peut ouvrir le répertoire %s."

#: src/fio.c:421
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Ce répertoire est nécessaire pour stocker les préférences et les information "
"du pad. Xpad va maintenant fermer."

