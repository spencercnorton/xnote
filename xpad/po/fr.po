#: src/main.c:204
msgid "Illegal \"--verbosity\" value.  Must be either 0, 1, or 2.\n"
msgstr "valeur illégale pour l'option \"--verbosity\". Doit être 0, 1 ou 2.\n"

#: src/main.c:266
msgid "Prints usage information and exits"
msgstr "Afficher l'aide-mémoire et quitter"

#: src/main.c:267
msgid "Prints xpad version and exits"
msgstr "Afficher la version de xpad et quitter"

#: src/main.c:268
msgid "Sets the amount of debugging ouput (can be 0, 1, or 2; default is 0)"
msgstr ""
"Fixer le niveau de sortie de la mise au point (0, 1 ou 2; 0 par défaut)"

#: src/main.c:269
msgid ""
"Prevents xpad from creating a new pad on startup if no previous pads exist"
msgstr ""
"Bloquer la création d'un nouveau pad lors du démarrage si aucun pad n'existe"

#. registered here a second time because it has effects both on local instances and remote instances
#: src/main.c:273
msgid "Causes xpad to create a new pad on startup even if pads already exist"
msgstr ""
"Provoque la craétion d'un nouveau pad lors du démarrage si un pad existe déjà"

#: src/main.c:274
msgid "Causes all running xpad instances to close"
msgstr "Provoque la fermeture de toutes les instances xpad"

#: src/main.c:275
msgid "Lists the titles of all open pads"
msgstr "Liste les titres de tous les pads ouverts"

#: src/main.c:276
msgid ""
"Causes the Nth pad (1-based) to present itself to the user; pad numbers can "
"be seen by using \"--list\""
msgstr ""
"Provoque le Nième pad (1-base) à s'afficher à l'usager; les numéros de pads "
"peuvent être obtenus en utilisant l'option \"--list\""

#: src/main.c:277
msgid "Causes all pads to present themselves to the user"
msgstr "Provoque l'affichage de tous les pads à l'usager"

#: src/main.c:309
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
msgstr ""
"Usage: xpad [OPTIONS]\n"
"\n"

