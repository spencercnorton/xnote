#: src/main.c:178
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
"  -V, --version         prints xpad version; exits\n"
"  -h, --help            prints this usage information; exits\n"
"  -v N, --verbosity=N   sets level of output\n"
"                          0=none, 1=moderate, 2=debug\n"
"                          default is 0\n"
"  -n, --new             opens a new pad only\n"
msgstr ""
"Folosire: xpad [OPÞIUNI]\n"
"\n"
"  -V, --version         afiºeazã opþiunile xpad ºi terminã\n"
"  -h, --help            afiºeazã aceste informaþii de folosire ºi terminã.\n"
"  -v N, --verbosity=N   seteazã nivel de output\n"
"                          0=nici unul, 1=moderat, 2=debug\n"
"                          implicit e 0\n"
"  -n, --new             deschide doar un pad nou.\n"

#: src/main.c:187
msgid ""
"  --nonew               prevents xpad from making a new pad\n"
"  -q, --quit            quits all open xpad sessions\n"
"  -l, --list            lists the titles of all pads\n"
"  -s N, --show=N        brings the Nth pad (1-based) to the foreground\n"
"  --showall             brings all pads to the foreground\n"
msgstr ""
"  --nonew               împiedicã xpad sã creeze un pad nou\n"
"  -q, --quit            închide toate sesiunile xpad deschise\n"
"  -l, --list            enumerã titlurile tuturor pad-urilor\n"
"  -s N, --show=N        aducere al N-lea pad (1-based) in prim-plan\n"
"  --showall             aducere toate pad0urile în prim plan\n"

