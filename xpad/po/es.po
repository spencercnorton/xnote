#~ "<b>Para redimensionar la nota</b>, arrastre con el botón izquierdo en\n"
#~ "el redimensionador o mantenga pulsado CTRL mientras arrastra con el\n"
#~ "botón derecho en cualquier parte de la nota.\n"
#~ "\n"

#~ msgid ""
