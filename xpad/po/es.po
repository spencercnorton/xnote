#: src/xpad-app.c:482
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Este directorio se necesita para almacenar las preferencias e información "
"sobre\n"
"las notas. Xpad se cerrará ahora."

