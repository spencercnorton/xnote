#: src/fio.c:134
#, c-format
msgid "Could not write to file %s."
msgstr "Đã không ghi được vào tập tin %s."

#: src/xpad-app.c:125
msgid "Xpad is a graphical program.  Please run it from your desktop."
msgstr "Xpad là một chương trình thuộc đồ họa. Hãy chạy nó từ màn hình nền của bạn."

#: src/xpad-app.c:130 xpad.desktop.in.h:3
msgid "Xpad"
msgstr "Xpad"

#: src/xpad-app.c:410
#, c-format
msgid "Could not open directory %s."
msgstr "Đã không mở được thư mục %s"

#: src/xpad-app.c:413
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Thư mục này được cần để cất giữ thông tin tham chiếu và tập giấy đều. Xpad sẽ thoát bây giờ."

#: src/xpad-app.c:717
msgid "Show version number and quit"
msgstr "Hiển thị số phiên bản rồi thoát"

#: src/xpad-app.c:718
msgid "Hide existing pads on startup"
msgstr "Giấu các tập giấy tồn tại khi khởi động"

#: src/xpad-app.c:719
msgid "Don't create a new pad on startup if no previous pads exist"
msgstr "Khi khởi động, không tạo một tập giấy mới nếu chưa có tập giấy trước nào."

#: src/xpad-app.c:725
msgid "Create a new pad on startup even if pads already exist"
msgstr "Tạo một tập giấy mới khi khởi động, dù tập giấy nào tồn tại."

#: src/xpad-app.c:726
msgid "Close all pads"
msgstr "Đóng tất cả tập giấy"

#: src/xpad-app.c:758
#, c-format
msgid "Xpad %s"
msgstr "Xpad %s"

#: src/xpad-pad.c:530
msgid "Delete this pad?"
msgstr "Xóa bỏ tập giấy này không?"

#: src/xpad-pad.c:531
msgid "All text of this pad will be irrevocably lost."
msgstr "Tất cả văn bản của tập giấy này sẽ bị mất mãi mãi."

#: src/xpad-pad.c:562
#, c-format
msgid "'%s' Properties"
msgstr "'Đặc tính riêng '%s'"

#: src/xpad-pad.c:1066
