#: src/eggtrayicon.c:118
msgid "Orientation"
msgstr "Treoshuíomh"

#: src/eggtrayicon.c:119
msgid "The orientation of the tray."
msgstr "Treoshuíomh an thráidire."

#: src/fio.c:133
#, c-format
msgid "Could not write to file %s."
msgstr "Níorbh fhéidir aon rud a scríobh chuig an chomhad %s."

#: src/xpad-app.c:114 xpad.desktop.in.h:3
msgid "Xpad"
msgstr "Xpad"

#: src/xpad-app.c:453
#, c-format
msgid "Could not open directory %s."
msgstr "Níorbh fhéidir an chomhadlann %s a oscailt."

#: src/xpad-app.c:456
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Ní foláir don chomhadlann seo a bheith oscailte le haghaidh eolas faoi na "
"ceapa agus do shainroghanna.  Druidfidh Xpad anois."

#: src/xpad-app.c:856
msgid "Prints usage information and exits"
msgstr "Taispeáin eolas faoin úsáid agus éirigh as"

#: src/xpad-app.c:857
msgid "Prints xpad version and exits"
msgstr "Taispeáin an leagan xpad agus éirigh as"

#: src/xpad-app.c:858
msgid ""
"Prevents xpad from creating a new pad on startup if no previous pads exist"
msgstr "Cuir cosc ar ceap nua i dtosach mura bhfuil ceap ann cheana féin"

#: src/xpad-app.c:864
msgid "Causes xpad to create a new pad on startup even if pads already exist"
msgstr "Cruthóidh xpad ceap nua i dtosach fiú má tá ceapa ann cheana féin"

#: src/xpad-app.c:865
msgid "Causes all running xpad instances to close"
msgstr "Dúnfaidh gach próiseas xpad atá beo faoi láthair"

#: src/xpad-app.c:881
#, c-format
msgid "Xpad %s\n"
msgstr "Xpad %s\n"

#: src/xpad-app.c:925
#, c-format
msgid ""
"Usage: %s [OPTIONS]\n"
"\n"
msgstr ""
"Úsáid: %s [ROGHANNA]\n"
"\n"

#: src/xpad-app.c:963
#, c-format
msgid "Missing companion argument to %s\n"
msgstr "Ní foláir argóint don rogha %s\n"

#: src/xpad-app.c:1007
#, c-format
msgid "Didn't understand argument '%s'\n"
msgstr "Argóint anaithnid %s.\n"

#: src/xpad-app.c:1056
#, c-format
msgid "Invalid number: '%s'\n"
msgstr "Uimhir neamhbhailí: '%s'\n"

#: src/xpad-pad.c:512
msgid "Delete this pad?"
msgstr "Ar mhaith leat an ceap seo a scriosadh?"

#: src/xpad-pad.c:513
msgid "All text of this pad will be irrevocably lost."
msgstr "Scriosfaidh an téacs uile atá sa cheap seo, gan fáil ar ais."

#: src/xpad-pad.c:544
#, c-format
msgid "'%s' Properties"
msgstr "'%s' Airíonna"

#: src/xpad-pad.c:1064
#, c-format
msgid "You are using xpad %s with GTK+ %i.%i.%i."
msgstr "Tá tú ag baint úsáid as xpad %s le GTK+ %i.%i.%i."

#: src/xpad-pad.c:1069
msgid "Visit http://xpad.sourceforge.net/ for more information about xpad."
msgstr ""
"Féach ar http://xpad.sourceforge.net/ chun tuilleadh eolais faoi xpad a "
"fháil."

