# Domhanda in FARF but that seems like bald Béarlachas - KPS
#: src/pref.c:351
msgid "Global Preferences"
msgstr "Airíonna Cuimsitheacha"

#: src/pref.c:370 src/properties.c:303
msgid "_Use system text color"
msgstr "Bain _úsáid as dath an théacs ón chóras"

#: src/pref.c:393 src/properties.c:324
msgid "_Use system background color"
msgstr "Bain _úsáid as dath an chúlra ón chóras"

#: src/pref.c:429 src/properties.c:357
msgid "The amount of space you want between the border and text."
msgstr "An méid spáis atá tú ag iarraidh idir an chiumhais agus an théacs."

#: src/pref.c:430 src/properties.c:358
msgid "Choose the number of pixels around the text region.  This space is colored the same and surrounds it on all sides."
msgstr "Roghnaigh líon na bpicsil timpeall an achair théacs.  Tá an dath céanna ar an achar seo agus tá sé ar gach dtaobh."

#: src/pref.c:443 src/properties.c:374
msgid "The amount of space you want surrounding the pad."
msgstr "An méid spáis atá tú ag iarraidh timpeall an chip nótaí."

#: src/pref.c:444 src/properties.c:375
msgid "Choose the number of pixels around the pad.  This space is colored independently and surrounds it on all sides."
msgstr "Roghnaigh líon na bpicsil timpeall an chip nótaí.  Tá a dhath féin ag an achar seo agus tá sé ar gach dtaobh."

#: src/pref.c:470 src/properties.c:397
msgid "_Use system font face"
msgstr "Bain _úsáid as an chló-aghaidh ón chóras"

# in FARF - KPS
#: src/pref.c:506
msgid "Click and drag a button to move it."
msgstr "Cliceáil agus tarraing cnaipe á haistriú."

#: src/pref.c:512
msgid "_Enable toolbar"
msgstr "_Cuir an barra uirlisí ar fáil"

# coinage - KPS
#: src/pref.c:513
msgid "_Auto-hide toolbar"
msgstr "_Uathfholaigh an barra uirlisí"

#: src/pref.c:523
msgid "<b>Toolbar Buttons:</b>"
msgstr "<b>Cnaipí ar an Bharra Uirlisí:</b>"

# guessing the present tense is really the intent -KPS
#: src/pref.c:524
msgid "<b>Used Buttons:</b>"
msgstr "<b>Cnaipí in úsáid:</b>"

# guessing the present tense is really the intent -KPS
#: src/pref.c:525
msgid "<b>Unused Buttons:</b>"
msgstr "<b>Cnaipí nach bhfuil in úsáid:</b>"

#: src/pref.c:642 src/pref.c:643
msgid "If on, a toolbar will appear below each pad when the mouse hovers over it."
msgstr "Más tofa é seo, d'fheicfeá barra uirlisí nuair atá an luchóg anuas ar an cheap."

#: src/pref.c:646 src/pref.c:647
msgid "If on, the toolbar will disappear when you are not using the pad."
msgstr "Más tofa é seo, imeoidh an barra uirlisí as radharc nuair atá an ceap ó úsáid."

#: src/pref.c:659
msgid "Allow _scrollbars"
msgstr "Ceadaigh _scrollbharraí"

#: src/pref.c:660
msgid "Pads start s_ticky"
msgstr "Tá na ceapa g_reamaitheacha ar dtús"

#: src/pref.c:663
msgid "Close and save _all pads"
msgstr "Dún agus sábháil _gach uile cheap nótaí"

#: src/pref.c:665
msgid "Close and save _pad"
msgstr "Dún agus sábháil an _ceap nótaí"

#: src/pref.c:667
msgid "_Destroy pad (no confirmation)"
msgstr "_Scrios an ceap nótaí (ní bheidh aon dheimhniú)"

#: src/pref.c:672
msgid "<b>Window Manager Close Action:</b>"
msgstr "<b>Bainisteoir Fuinneoga - Gníomh Dúnta:</b>"

#: src/pref.c:717 src/pref.c:719
msgid "If on, your window manager will add its own decorations to each pad.  For example, a titlebar and close button."
msgstr "Más tofa é seo, cuirfidh do bhainisteoir fuinneoga a maisiúcháin féin le gach ceap nótaí.  Mar shampla, barra teidil agus cnaipe dhúnta."

#: src/pref.c:723 src/pref.c:724
msgid "If on, choosing to destroy a pad will prompt for conformation."
msgstr "Más tofa é seo, d'iarrfaí cinntiú nuair is mian leat ceap nótaí a scriosadh."

#: src/pref.c:727 src/pref.c:728
msgid "If on, new pads are sticky by default."
msgstr "Más tofa é seo, beidh ceapa nua greamaitheacha trí mhainneachtain."

#: src/pref.c:731 src/pref.c:733
msgid "If on, scrollbars appear when text is larger than the pad.  If off, the pad resizes to fit the text."
msgstr "Más tofa é seo, nochtfaí scrollbharraí nuair nach dtoilleann an téacs sa cheap nótaí.  Murab é, d'fheisteodh an ceap é féin don théacs."

#: src/pref.c:737 src/pref.c:740
msgid "If on, when a pad loses focus, it will become uneditable.  This allows you to move it by left dragging.  To make it editable again, double-click the pad.  If off, pads are always editable."
msgstr "Más tofa é seo, nuair atá ceap as fócas, tá sé do-eagraithe.   Dá bhrí seo, is féidir leat é a bhogadh trí tharraingt ar clé.  Cliceáil an ceap faoi dhó chun é a dhéanamh ineagraithe arís. Mura tofa, tá ceapa ineagraithe i dtólamh."

#: src/pref.c:745 src/pref.c:746
msgid "All pads will close, saving contents first."
msgstr "Dúnfaidh gach uile ceap nótaí; sábhálfar an t-ábhar i dtosach."

#: src/pref.c:749 src/pref.c:750
msgid "The pad you clicked the close button on will close, saving contents."
msgstr "Dúnfaidh an ceap a bhí tofa leis an chnaipe dúnta, ag sábháil a ábhar."

#: src/pref.c:753 src/pref.c:755
msgid "The pad you clicked the close button on will be destroyed, losing contents.  There will be no confirmation."
msgstr "Scriosfar an ceap a bhí tofa leis an chnaipe dúnta, ag cailleadh a ábhar.  Ní bheidh aon dheimhniú."

