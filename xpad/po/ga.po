msgid "Allow _window manager decorations"
msgstr "Ceadaigh maisiúcháin ón bhainisteoir _fuinneoga"

#: src/pref.c:305
msgid "Con_firm pad destruction"
msgstr "_Dearbhaigh scrios an cheap nótaí"

#: src/pref.c:306
