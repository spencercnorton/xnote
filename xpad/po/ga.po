#: src/main.c:198
msgid "Illegal \"--verbosity\" value.  Must be either 0, 1, or 2.\n"
msgstr "Modh \"--verbosity\" neamhcheadaithe.  Ní foláir dó a bheith 0, 1, nó 2.\n"

#: src/main.c:260
msgid "Prints usage information and exits"
msgstr "Taispeáin eolas faoin úsáid agus éirigh as"

#: src/main.c:261
msgid "Prints xpad version and exits"
msgstr "Taispeáin an leagan xpad agus éirigh as"

#: src/main.c:262
msgid "Sets the amount of debugging ouput (can be 0, 1, or 2; default is 0)"
msgstr "Socraigh an leibhéal d'aschur dífhabhtaithe (0, 1, nó 2; luach loicthe 0)"

#: src/main.c:263
msgid "Prevents xpad from creating a new pad on startup if no previous pads exist"
msgstr "Cuir cosc ar ceap nua i dtosach mura bhfuil ceap ann cheana féin"

#. registered here a second time because it has effects both on local instances and remote instances
#: src/main.c:267
msgid "Causes xpad to create a new pad on startup even if pads already exist"
msgstr "Cruthóidh xpad ceap nua i dtosach fiú má tá ceapa ann cheana féin"

#: src/main.c:268
msgid "Causes all running xpad instances to close"
msgstr "Dúnfaidh gach próiseas xpad atá beo faoi láthair"

#: src/main.c:269
msgid "Lists the titles of all open pads"
msgstr "Taispeáin na teidil de na ceapa oscailte"

#: src/main.c:270
msgid "Causes the Nth pad (1-based) to present itself to the user; pad numbers can be seen by using \"--list\""
msgstr "Taispeáin an ceap Nú (bunaithe ag 1) chuig an úsáideoir; féach ar uimhreacha le \"--list\""

#: src/main.c:271
msgid "Causes all pads to present themselves to the user"
msgstr "Taispeáin gach ceap chuig an úsáideoir"

#: src/main.c:303
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
msgstr ""
"Úsáid: xpad [ROGHANNA]\n"
"\n"

#: src/main.c:339
#, c-format
msgid "Missing companion argument to %s\n"
msgstr "Ní foláir argóint don rogha %s\n"

#: src/main.c:388
#, c-format
msgid "Didn't understand argument '%s'\n"
msgstr "Argóint anaithnid %s.\n"

#: src/main.c:444
#, c-format
msgid "Invalid number: '%s'\n"
msgstr "Uimhir neamhbhailí: '%s'\n"

#: src/fio.c:84
#, c-format
msgid "Could not write to file %s."
msgstr "Níorbh fhéidir aon rud a scríobh chuig an chomhad %s."

#: src/fio.c:110
#, c-format
msgid "Could not read from file %s."
msgstr "Níorbh fhéidir aon rud a léamh as an gcomhad %s."

#: src/fio.c:438
#, c-format
msgid "Could not open directory %s."
msgstr "Níorbh fhéidir an chomhadlann %s a oscailt."

#: src/fio.c:441
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Ní foláir don chomhadlann seo a bheith oscailte le haghaidh eolas faoi na ceapa agus na hairíonna.  Druidfidh Xpad anois."

