#: src/main.c:173
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
"  -V, --version         prints xpad version and exits\n"
"  -h, --help            prints this usage information and exits\n"
"  -v N, --verbosity=N   sets level of output\n"
"                          0=none, 1=moderate, 2=debug\n"
"                          default is 0\n"
"  -n, --new             opens a new pad only\n"
msgstr ""
"Usage: xpad [OPTIONS]\n"
"\n"
"  -V, --version         Выводит версию xpad и завершает работу\n"
"  -h, --help            Выводит эту справку об использовании xpad и завершает работу\n"
"  -v N, --verbosity=N   Устанавливает уровень детализации вывода\n"
"                          0=молча, 1=ограниченно, 2=отладка\n"
"                          по умолчанию используется уровень 0\n"
"  -n, --new             Открывает только новую записку\n"

#: src/main.c:182
msgid ""
"  --nonew               prevents xpad from making a new pad\n"
"  -q, --quit            quits all open xpad sessions\n"
"  -l, --list            lists the titles of all pads\n"
"  -s N, --show=N        brings the Nth pad (1-based) to the foreground\n"
"  --showall             brings all pads to the foreground\n"
msgstr ""
"  --nonew               Защищает от создания новых записок\n"
"  -q, --quit            Завершает работу всех сессий/копий xpad\n"
"  -l, --list            Выводит список заголовков всех записок\n"
"  -s N, --show=N        Передвигает на верхний уровень записку под номером N (Начиная с 1)\n"
"  --showall             Передвигает на верхний уровень все записки.\n"




#: src/main.c:215
msgid "Illegal verbosity value.  Must be between 0 and 2 inclusive.\n"
msgstr "Неправильное значение уровня детализации вывода. Оно должно быть от 0 до 2 включительно.\n"


