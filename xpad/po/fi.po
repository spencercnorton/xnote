#, c-format
msgid "Could not open directory %s."
msgstr "Ei voitu avata hakemistoa %s."

#: ../src/xpad-app.c:434
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Tämä hakemisto tarvitaan tallentamaan ensisijaisuus- ja lapputietoja. Xpad sulkeutuu nyt."

#: ../src/xpad-app.c:738
msgid "Show version number and quit"
