#: src/fio.c:134
#, c-format
msgid "Could not write to file %s."
msgstr "Nedá sa zapisovať do súboru %s."

#: src/xpad-app.c:125
msgid "Xpad is a graphical program.  Please run it from your desktop."
msgstr "Xpad je grafický program.  Prosím, spustite ho z pracovnej plochy."

#: src/xpad-app.c:130 xpad.desktop.in.h:3
msgid "Xpad"
msgstr "Xpad"

#: src/xpad-app.c:435
#, c-format
msgid "Could not open directory %s."
msgstr "Priečinok %s sa nedá otvoriť."

#: src/xpad-app.c:438
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Tento priečinok je potrebný pre uloženie nastavení a blokov.  Xpad sa teraz ukončí."

#: src/xpad-app.c:742
msgid "Show version number and quit"
msgstr "Zobraziť číslo verzie a ukončiť"

#: src/xpad-app.c:743
msgid "Hide existing pads on startup"
msgstr "Pri štarte skryť existujúce bloky"

#: src/xpad-app.c:744
msgid "Don't create a new pad on startup if no previous pads exist"
msgstr "Ak už nejaké bloky existujú, pri štarte nevytvárať nový blok"

#: src/xpad-app.c:750
msgid "Create a new pad on startup even if pads already exist"
msgstr "Vytvoriť nový blok pri štarte aj v prípade, že už nejaké existujú"

#: src/xpad-app.c:751
msgid "Close all pads"
msgstr "Zatvoriť všetky bloky"

#: src/xpad-app.c:783
#, c-format
msgid "Xpad %s"
msgstr "Xpad %s"

#: src/xpad-pad.c:557
msgid "Delete this pad?"
msgstr "Odstrániť tento blok?"

#: src/xpad-pad.c:558
msgid "All text of this pad will be irrevocably lost."
msgstr "Všetok text v tomto bloku bude nenávratne stratený."

#: src/xpad-pad.c:589
#, c-format
msgid "'%s' Properties"
msgstr "'%s' Vlastnosti"

#: src/xpad-pad.c:1109
msgid "Sticky notes"
msgstr "Prilepené poznámky"

