#: src/fio.c:134
#, c-format
msgid "Could not write to file %s."
msgstr "Kunne ikke skrive til fil %s."

#: src/xpad-app.c:125
msgid "Xpad is a graphical program.  Please run it from your desktop."
msgstr "Xpad er et grafisk program som skal køres fra dit skrivebord."

#: src/xpad-app.c:130 xpad.desktop.in.h:3
msgid "Xpad"
msgstr "Xpad"

#: src/xpad-app.c:435
#, c-format
msgid "Could not open directory %s."
msgstr "Kunne ikke åbne katalog %s."

#: src/xpad-app.c:438
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Dette katalog er nødvendigt for at gemme indstillinger og information for noter. Xpad vil afslutte nu."

#: src/xpad-app.c:742
msgid "Show version number and quit"
msgstr "Vis versionsnummer og afslut"

#: src/xpad-app.c:743
msgid "Hide existing pads on startup"
msgstr "Skjul eksisterende noter ved opstart"

#: src/xpad-app.c:744
msgid "Don't create a new pad on startup if no previous pads exist"
msgstr "Opret ikke en ny note ved opstart hvis ingen tidligere noter eksisterer"

#: src/xpad-app.c:750
msgid "Create a new pad on startup even if pads already exist"
msgstr "Opret en ny note ved opstart, selvom noter allerede eksisterer"

#: src/xpad-app.c:751
msgid "Close all pads"
msgstr "Luk alle noter"

#: src/xpad-app.c:783
#, c-format
msgid "Xpad %s"
msgstr "Xpad %s"

#: src/xpad-pad.c:557
msgid "Delete this pad?"
msgstr "Slet denne note?"

#: src/xpad-pad.c:558
msgid "All text of this pad will be irrevocably lost."
msgstr "Al tekst på denne note vil blive tabt for altid."

#: src/xpad-pad.c:589
#, c-format
msgid "'%s' Properties"
msgstr "Egenskaber for \"%s\""

