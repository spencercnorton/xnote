msgid "Options"
msgstr "Opsies"

#: src/pref.c:295
msgid "Toolbar"
msgstr "Nutsbalk"

#: src/pref.c:296 src/properties.c:234
msgid "_Padding:"
msgstr "_Vulling"

#: src/pref.c:303
msgid "Allow _window manager decorations"
msgstr "Laat _vensterbestuurderversierings toe"

#: src/pref.c:304
msgid "Con_firm pad destruction"
msgstr "_Bevestig vernietiging van boekie"

#: src/pref.c:305
msgid "_Edit lock"
msgstr "_Redigeer slot"

#: src/pref.c:350
msgid "Global Preferences"
msgstr "Globale voorkeure"

#: src/pref.c:369 src/properties.c:303
msgid "_Use system text color"
msgstr "_Gebruikstelsel se tekskleur"

#: src/pref.c:392 src/properties.c:324
msgid "_Use system background color"
msgstr "_Gebruik stelsel se agtergrondkleur"

#: src/pref.c:428 src/properties.c:357
msgid "The amount of space you want between the border and text."
msgstr "Die hoeveelheid spasie wat jy tussen die rand en die teks wil hê."

#: src/pref.c:429 src/properties.c:358
msgid "Choose the number of pixels around the text region.  This space is colored the same and surrounds it on all sides."
msgstr "Kies die aantal pixels rondom die teksarea.  Hierdie spasie kry dieselfde kleur en is rondom die hele teks."

#: src/pref.c:442 src/properties.c:374
msgid "The amount of space you want surrounding the pad."
msgstr "Die hoeveelheid spasie wat jy rondom die teks wil hê."

#: src/pref.c:443 src/properties.c:375
msgid "Choose the number of pixels around the pad.  This space is colored independently and surrounds it on all sides."
msgstr "Kies die aantal pixels rondom die boekie.  Hierdie spasie kry 'n onafhanklike kleur en is rondom die hele boekie."

#: src/pref.c:469 src/properties.c:397
msgid "_Use system font face"
msgstr "_Gebruik stelsellettertipe"

#: src/pref.c:505
msgid "Click and drag a button to move it."
msgstr "Klik en sleep 'n knoppie om dit te skuif."

#: src/pref.c:511
msgid "_Enable toolbar"
msgstr "_Aktiveer nutsbalk"

#: src/pref.c:512
msgid "_Auto-hide toolbar"
msgstr "_Outoverberg nutsbalk"

#: src/pref.c:522
msgid "<b>Toolbar Buttons:</b>"
msgstr "<b> Nutsbalk knoppies:</b>"

#: src/pref.c:523
msgid "<b>Used Buttons:</b>"
msgstr "<b>Gebruikte knoppies:</b>"

#: src/pref.c:524
msgid "<b>Unused Buttons:</b>"
msgstr "<b>Ongebruikte knoppies:</b>"

#: src/pref.c:642 src/pref.c:643
msgid "If on, a toolbar will appear below each pad when the mouse hovers over it."
msgstr "Indien aan, sal 'n nutsbalk aan die onderkant van elke boekie verskyn wanneer die muis daaroor hang."

#: src/pref.c:646 src/pref.c:647
msgid "If on, the toolbar will disappear when you are not using the pad."
msgstr "Indien aan, sal die nutsbalk verdwyn wanneer die boekie nie in gebruik is nie."

#: src/pref.c:659
msgid "Allow _scrollbars"
msgstr "Laat _Rolstawe toe"

#: src/pref.c:660
msgid "Pads start s_ticky"
msgstr "Boekie begin _klewerig"

#: src/pref.c:663
msgid "Close and save _all pads"
msgstr "Maak toe en stoor _alle boekies"

#: src/pref.c:665
msgid "Close and save _pad"
msgstr "Maak toe en stoor boekie"

#: src/pref.c:667
msgid "_Destroy pad (no confirmation)"
msgstr "_Vernietig boekie (geen bevestiging)"

#: src/pref.c:672
msgid "<b>Window Manager Close Action:</b>"
msgstr "<b>Vensterbestuurderafsluitaksie:</b>"

#: src/pref.c:717 src/pref.c:719
msgid "If on, your window manager will add its own decorations to each pad.  For example, a titlebar and close button."
msgstr "Indien aan, sal die vensterbestuurder sy eie versierings byvoeg by elke boekie, byvoorbeeld 'n titelbalk en afsluitknoppie."

#: src/pref.c:723 src/pref.c:724
msgid "If on, choosing to destroy a pad will prompt for conformation."
msgstr "Indien aan, sal jy vir bevestiging gevra word voordat 'n boekie vernietig word."

#: src/pref.c:727 src/pref.c:728
msgid "If on, new pads are sticky by default."
msgstr "Indien aan, sal nuwe boekies se verstektoestand klewerig wees."

#: src/pref.c:731 src/pref.c:733
msgid "If on, scrollbars appear when text is larger than the pad.  If off, the pad resizes to fit the text."
msgstr "Indien aan,  sal rolstawe verskyn wanneer die teks groter is as die boekie.  Indien af, sal die boekie groei om die teks te bevat."

#: src/pref.c:737 src/pref.c:740
msgid "If on, when a pad loses focus, it will become uneditable.  This allows you to move it by left dragging.  To make it editable again, double-click the pad.  If off, pads are always editable."
msgstr "Indien aan, sal 'n boekie nie-redigeerbaar wees wanner dit fokus verloor.  Dit maak dit moontlik om dit te skuif met links-sleep.  Om dit weer redigeerbaar te maak, moet jy die boekie dubbelklik.  Indien af, sal die boekies altyd redigeerbaar bly."

#: src/pref.c:745 src/pref.c:746
msgid "All pads will close, saving contents first."
msgstr "Alle boekies sal toemaak maar eers die inhoud stoor."

#: src/pref.c:749 src/pref.c:750
msgid "The pad you clicked the close button on will close, saving contents."
msgstr "Die boekie waarop jy die toemaakknoppie geklik het, sal toemaak en die inhoud stoor."

#: src/pref.c:753 src/pref.c:755
msgid "The pad you clicked the close button on will be destroyed, losing contents.  There will be no confirmation."
msgstr "Die boekie waarop jy die toemaakknoppie geklik het sal vernietig word en sy inhoud verloor.  Daar word nie gevra vir bevestiging nie."

