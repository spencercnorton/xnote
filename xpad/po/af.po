#: src/main.c:205
msgid "Illegal \"--verbosity\" value.  Must be either 0, 1, or 2.\n"
msgstr "Ongeldige \"--verbosity\" waarde.  Moet wees 0, 1, of 2.\n"

#: src/main.c:267
msgid "Prints usage information and exits"
msgstr "Vertoon gebruik-inligting en stop"

#: src/main.c:268
msgid "Prints xpad version and exits"
msgstr "Vertoon xpad weergawe en stop"

#: src/main.c:269
msgid "Sets the amount of debugging ouput (can be 0, 1, or 2; default is 0)"
msgstr "Stel die hoeveelheid ontfoutboodskappe (kan 0, 1 of 2 wees; verstekwaarde is 0)"

#: src/main.c:270
msgid "Prevents xpad from creating a new pad on startup if no previous pads exist"
msgstr "Keer dat xpad 'n nuwe boekie maak wanneer dit begin uitvoer, as daar nog nie 'n boekie bestaan nie."

#  registered here a second time because it has effects both on local instances and remote instances
#  registered here a second time because it has effects both on local instances and remote instances
#. registered here a second time because it has effects both on local instances and remote instances
#: src/main.c:274
msgid "Causes xpad to create a new pad on startup even if pads already exist"
msgstr "Sorg dat xpad 'n nuwe boekie maak wanneer dit begin uitvoer, self al bestaan daar reeds 'n boekie."

#: src/main.c:275
msgid "Causes all running xpad instances to close"
msgstr "Maak alle xpad-eksemplare toe"

#: src/main.c:276
msgid "Lists the titles of all open pads"
msgstr "Lys die titels van al die oop boekies"

#: src/main.c:277
msgid "Causes the Nth pad (1-based) to present itself to the user; pad numbers can be seen by using \"--list\""
msgstr "Sorg dat die N-de pad (1-gebaseer"

#: src/main.c:278
msgid "Causes all pads to present themselves to the user"
msgstr "Sorg dat alle boekies aan die gebruiker gewys word."

#: src/main.c:310
msgid ""
"Usage: xpad [OPTIONS]\n"
"\n"
msgstr ""
"Gebruik so:  xpad [OPSIES]\n"
"\n"

#: src/main.c:346
#, c-format
msgid "Missing companion argument to %s\n"
msgstr "Parameter %s moet 'n maatjie hê\n"

#: src/main.c:395
#, c-format
msgid "Didn't understand argument '%s'\n"
msgstr "Parameter '%s'was onverstaanbaar\n"

#: src/main.c:451
#, c-format
msgid "Invalid number: '%s'\n"
msgstr "Ongeldige nommer '%s'\n"

#: src/fio.c:84
#, c-format
msgid "Could not write to file %s."
msgstr "Kon nie na lêer %s skryf nie."

#: src/fio.c:110
#, c-format
msgid "Could not read from file %s."
msgstr "Kon nie uit lêer %s lees nie."

#: src/fio.c:438
#, c-format
msgid "Could not open directory %s."
msgstr "Kon nie gids %s oopmaak nie."

#: src/fio.c:441
msgid "This directory is needed to store preference and pad information.  Xpad will close now."
msgstr "Hierdie gids word benodig om voorkeure en boekie-inligting te stoor.  Xpad sal nou afsluit."

