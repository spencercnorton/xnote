VERSION = @VERSION@
VERNAME = xpad-$(VERSION)

SHELL = /bin/sh
top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@

subdirs = src images doc

INSTALL = @INSTALL@
INSTALL_PROGRAM = $(INSTALL)
INSTALL_DATA = $(INSTALL) -m 644
prefix = @prefix@
exec_prefix = @exec_prefix@
datadir = @datadir@
bindir = @bindir@
libdir = @libdir@
infodir = @infodir@
mandir = @mandir@
desktopdir = $(shell $(top_srcdir)/scripts/finddesktopdir $(datadir)/applications)


all:
	@for dir in ${subdirs}; do \
	  (cd $$dir && $(MAKE) all) \
	  || case "$(MFLAGS)" in *k*) fail=yes;; *) exit 1;; esac; \
	done && test -z "$$fail"

install: all
	$(top_srcdir)/autoconf/mkinstalldirs $(desktopdir)
	$(INSTALL_DATA) xpad.desktop $(desktopdir)
	@for dir in ${subdirs}; do \
	  (cd $$dir && $(MAKE) install) \
	  || case "$(MFLAGS)" in *k*) fail=yes;; *) exit 1;; esac; \
	done && test -z "$$fail"

uninstall:
	/bin/rm -f $(desktopdir)/xpad.desktop
	@for dir in ${subdirs}; do \
	  (cd $$dir && $(MAKE) uninstall) \
	  || case "$(MFLAGS)" in *k*) fail=yes;; *) exit 1;; esac; \
	done && test -z "$$fail"

clean:
	@for dir in ${subdirs}; do \
	  (cd $$dir && $(MAKE) clean) \
	  || case "$(MFLAGS)" in *k*) fail=yes;; *) exit 1;; esac; \
	done && test -z "$$fail"

distclean: clean
	/bin/rm -f *~ .\#* Makefile config.status config.cache config.log autoconf/stamp-h
	@for dir in ${subdirs}; do \
	  (cd $$dir && $(MAKE) distclean) \
	  || case "$(MFLAGS)" in *k*) fail=yes;; *) exit 1;; esac; \
	done && test -z "$$fail"

mostlyclean: clean

maintainer-clean: clean


# the next several rules are inspired by the aterm project's Makefile.in
prepdistdir:
	(cd ..; cp -r main $(VERNAME); cd $(VERNAME); $(MAKE) distclean;)

tar.gz: ../$(VERNAME).tar.gz
../$(VERNAME).tar.gz: prepdistdir
	(cd ..;\
	tar cfh - $(VERNAME) | gzip --best > $(VERNAME).tar.gz;\
	rm -r $(VERNAME))

tar.Z: ../$(VERNAME).tar.Z
../$(VERNAME).tar.Z: prepdistdir
	(cd ..;\
	tar cfh - $(VERNAME) | compress > $(VERNAME).tar.Z;\
	rm -r $(VERNAME))

tar.bz2: ../$(VERNAME).tar.bz2
../$(VERNAME).tar.bz2: prepdistdir
	(cd ..;\
	tar cfh - $(VERNAME) | bzip2 -f --best > $(VERNAME).tar.bz2;\
	rm -r $(VERNAME))

zip: ../$(VERNAME).zip
../$(VERNAME).zip: prepdistdir
	(cd ..;\
	zip -9 -qr - $(VERNAME) > $(VERNAME).zip;\
	rm -r $(VERNAME))

uuencode: ../$(VERNAME).tar.gz
	uuencode ../$(VERNAME).tar.gz $(VERNAME).tar.gz > ../$(VERNAME).tgz.uu



# automatic re-running of configure if the configure.in file has changed
${srcdir}/configure: autoconf/configure.in
	cd ${srcdir} && autoconf autoconf/configure.in > configure

# autoheader might not change config.h.in, so touch a stamp file
${srcdir}/autoconf/config.h.in: autoconf/stamp-h.in
${srcdir}/autoconf/stamp-h.in: autoconf/configure.in
	cd ${srcdir} && autoheader autoconf/configure.in > autoconf/config.h.in
	echo timestamp > ${srcdir}/autoconf/stamp-h.in

src/config.h: autoconf/stamp-h
autoconf/stamp-h: autoconf/config.h.in config.status
	./config.status
Makefile: Makefile.in src/Makefile.in images/Makefile.in doc/Makefile.in config.status
	./config.status
config.status: configure
	./config.status --recheck
