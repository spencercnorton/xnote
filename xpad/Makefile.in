VERSION = @VERSION@
VERNAME = xpad-$(VERSION)

SHELL = /bin/sh
top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@

.SUFFIXES:
.SUFFIXES: .c .o

CC = gcc

CFLAGS = -I. @CFLAGS@ -ansi -pedantic -Wall\
 `pkg-config --cflags gtk+-2.0`\
 -DG_DISABLE_DEPRECATED -DGDK_DISABLE_DEPRECATED\
 -DGDK_PIXMAP_DISABLE_DEPRECATED -DGTK_DISABLE_DEPRECATED

LDFLAGS = @LDFLAGS@
LIBS = @LIBS@ `pkg-config --libs gtk+-2.0`
INSTALL = @INSTALL@
prefix = @prefix@
exec_prefix = @exec_prefix@
datadir = @datadir@
bindir = @bindir@
libdir = @libdir@
infodir = @infodir@
mandir = @mandir@
icondir = $(datadir)/pixmaps/xpad

SOURCES=main.c fio.c pref.c pad.c help.c toolbar.c tray.c eggtrayicon.c
DOCS=xpad.1
MISC=configure mkinstalldirs install-sh #aclocal.m4
OBJS=main.o fio.o pref.o pad.o help.o toolbar.o tray.o eggtrayicon.o

all: xpad

install: all
	$(top_srcdir)/mkinstalldirs $(bindir)
	$(top_srcdir)/mkinstalldirs $(mandir)/man1
	$(top_srcdir)/mkinstalldirs $(icondir)
	$(INSTALL) xpad $(bindir)
	$(INSTALL) xpad.1 $(mandir)/man1
	$(INSTALL) xpad.xpm $(icondir)

uninstall:
	/bin/rm -f $(bindir)/xpad
	/bin/rm -f $(mandir)/man1/xpad.1*
	/bin/rm -f $(icondir)/xpad.xpm

xpad: $(OBJS)
	$(CC) $(LDFLAGS) -o xpad $(OBJS) $(LIBS)

clean:
	/bin/rm -f core *.o $(OBJS)

distclean: clean
	/bin/rm -f *~ .\#* Makefile config.h config.status config.cache config.log stamp-h

mostlyclean: clean

maintainer-clean: clean


# the next several rules are inspired by the aterm project's Makefile.in
prepdistdir:
	(cd ..; cp -r main $(VERNAME); cd $(VERNAME); make distclean;)

tar.gz: ../$(VERNAME).tar.gz
../$(VERNAME).tar.gz: prepdistdir
	(cd ..;\
	tar cf - $(VERNAME) | gzip --best > $(VERNAME).tar.gz;\
	rm -r $(VERNAME))

tar.Z: ../$(VERNAME).tar.Z
../$(VERNAME).tar.Z: prepdistdir
	(cd ..;\
	tar cf - $(VERNAME) | compress > $(VERNAME).tar.Z;\
	rm -r $(VERNAME))

tar.bz2: ../$(VERNAME).tar.bz2
../$(VERNAME).tar.bz2: prepdistdir
	(cd ..;\
	tar cf - $(VERNAME) | bzip2 -f --best > $(VERNAME).tar.bz2;\
	rm -r $(VERNAME))

zip: ../$(VERNAME).zip
../$(VERNAME).zip: prepdistdir
	(cd ..;\
	zip -9 -qr - $(VERNAME) > $(VERNAME).zip;\
	rm -r $(VERNAME))

uuencode: tar.gz
	uuencode ../$(VERNAME).tar.gz $(VERNAME).tar.gz > ../$(VERNAME).tgz.uu




# automatic re-running of configure if the configure.in file has changed
${srcdir}/configure: configure.in #aclocal.m4
	cd ${srcdir} && autoconf

# autoheader might not change config.h.in, so touch a stamp file
${srcdir}/config.h.in: stamp-h.in
${srcdir}/stamp-h.in: configure.in #aclocal.m4
		cd ${srcdir} && autoheader
		echo timestamp > ${srcdir}/stamp-h.in

config.h: stamp-h
stamp-h: config.h.in config.status
	./config.status
Makefile: Makefile.in config.status
	./config.status
config.status: configure
	./config.status --recheck
