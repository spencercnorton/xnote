#!/bin/sh
# prerm: disable the old xpad-cloud-backup timer before it becomes orphaned
set -e
case "$1" in
    install|upgrade)
        # Disable the old xpad timer for all users who have it enabled, so
        # the unit file deletion (by Conflicts/Replaces) doesn't leave a
        # broken enabled unit behind.  Best-effort: ignore failure if the
        # unit isn't present or the user daemon isn't running.
        if command -v loginctl >/dev/null 2>&1; then
            for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
                XDG_RUNTIME_DIR="/run/user/$uid" \
                    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                    systemctl --user disable --now xpad-cloud-backup.timer 2>/dev/null || true
            done
        fi
        ;;
esac
