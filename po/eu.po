#: ../src/xpad-app.c:470
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Direktorio hau beharrezkoa da ezarpenak eta oharretako informazioa "
"gordetzeko. Xpad orain itxiko da."

