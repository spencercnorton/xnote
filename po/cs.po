#: ../src/fio.c:129
#, c-format
msgid "Could not write to file %s: %s"
msgstr "Nemohu zapisovat do souboru %s: %s"

#: ../src/help.c:49
msgid ""
"Each xpad session consists of one or more open pads.  These pads are "
"basically sticky notes on your desktop in which you can write memos."
msgstr ""
"Každý spuštěný Xpad sestává z jednoho nebo více otevřených lepítek. Lepítka "
"na ploše Vám slouží k psání poznámek."

#: ../src/help.c:52
msgid ""
"<b>To move a pad</b>, left drag on the toolbar, right drag on the resizer in "
"the bottom right, or hold down CTRL while left dragging anywhere on the pad."
msgstr ""
"<b>Přesun lepítka</b> -  tažení levým tlačítkem myši za titulek lepítka nebo "
"při stisknuté klávese CTRL táhněte levým tlačítkem myši."

#: ../src/help.c:55
msgid ""
"<b>To resize a pad</b>, left drag on the resizer or hold down CTRL while "
"right dragging anywhere on the pad."
msgstr ""
"<b>Změna velikosti lepítka</b> - změna velikosti lepítka ovladačem v dolním "
"pravém rohu nebo při stisknuté klávese CTRL táhněte pravým tlačítkem myši."

#: ../src/help.c:57
msgid ""
"<b>To change color settings</b>, right click on a pad and choose Edit-"
">Preferences."
msgstr ""
"<b>Změna nastavení barev</b> - pravé kliknutí na lepítko a zvolte <i>Upravit-"
">Nastavení</i>."

#: ../src/help.c:59
msgid ""
"Most actions are available throught the popup menu that appears when you "
"right click on a pad.  Try it out and enjoy."
msgstr ""
"Většina akcí je dostupná pomocí kontextového menu, které se objeví po "
"kliknutí pravým kliknutím myši na lepítko. Zkuste to - je to jednoduché!"

#: ../src/help.c:62
msgid ""
"Please send ideas or bug reports to\n"
"https://bugs.launchpad.net/xpad/+filebug"
msgstr ""

