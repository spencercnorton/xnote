#: ../src/fio.c:129
#, c-format
msgid "Could not write to file %s: %s"
msgstr "לא ניתן לכתוב לקובץ %s:‏ %s"

#: ../src/help.c:49
msgid ""
"Each xpad session consists of one or more open pads.  These pads are "
"basically sticky notes on your desktop in which you can write memos."
msgstr ""
"כל הפעלה של Xpad מורכבת מלוח אחד או יותר. לוחות אלה בהגדרתן הן פתקים נצמדים "
"על שולחן העבודה שלך שבהן ניתן לכתוב מזכרים."

#: ../src/help.c:52
msgid ""
"<b>To move a pad</b>, left drag on the toolbar, right drag on the resizer in "
"the bottom right, or hold down CTRL while left dragging anywhere on the pad."
msgstr ""
"<b>כדי להעביר לוח</b>, גרירה בשמאל על סרגל הכלים, גרירה בימין על סמן החלפת "
"הגודל מצד ימין למטה, או להחזיק CTRL במהלך גרירה בשמאל בכל מקום על גבי הלוח."

#: ../src/help.c:55
msgid ""
"<b>To resize a pad</b>, left drag on the resizer or hold down CTRL while "
"right dragging anywhere on the pad."
msgstr ""
"<b>כדי לשנות גודל של לוח</b>, לחיצה בשמאל על סמן החלפת הגודל או להחזיק CTRL "
"בעת גרירה בימין בכל מקום על הלוח."

#: ../src/help.c:57
msgid ""
"<b>To change color settings</b>, right click on a pad and choose Edit-"
">Preferences."
msgstr ""
"<b>כדי לשנות הגדרות צבע</b>, לחיצה בימין על הלוח ולבחור בעריכה -> העדפות."

#: ../src/help.c:59
msgid ""
"Most actions are available throught the popup menu that appears when you "
"right click on a pad.  Try it out and enjoy."
msgstr ""
"רוב הפעולות זמינות דרך התפריט המוקפץ שמופיע בעת לחיצה בימין על הלוח. כדאי "
"לנסות וליהנות."

#: ../src/help.c:62
msgid ""
"Please send ideas or bug reports to\n"
"https://bugs.launchpad.net/xpad/+filebug"
msgstr ""

