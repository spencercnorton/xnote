#: ../src/xpad-app.c:470
msgid ""
"This directory is needed to store preference and pad information.  Xpad will "
"close now."
msgstr ""
"Dette katalog er nødvendigt for at gemme indstillinger og information for "
"noter. Xpad vil afslutte nu."

